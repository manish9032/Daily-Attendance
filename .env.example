# GEMINI_API_KEY: used by the SERVER to verify the selfie face (server/secureAttendance.ts).
# AI Studio injects this at runtime from user secrets. Locally put it in .env.local
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: model used for the face check (default: gemini-2.5-flash)
# GEMINI_MODEL="gemini-2.5-flash"

# LOCAL DEVELOPMENT ONLY: skip the Gemini face check. Ignored when NODE_ENV=production.
# SKIP_FACE_CHECK="true"

# Firebase Admin credentials (server writes attendance with the Admin SDK).
# On Cloud Run / AI Studio hosting this is automatic (Application Default Credentials).
# Locally, run:  gcloud auth application-default login
# or point to a service-account key file (NEVER commit it):
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
